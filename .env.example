# =============================================================================
# ReviewGraph AI — configuration
# =============================================================================
# Copy to .env and fill in. No code changes needed to review a new repository.
#
# Data source (pick one):
#   demo    — built-in synthetic org (default if nothing else is set)
#   github  — set GITHUB_REPO (and GITHUB_TOKEN for private repos)
#   gitlab  — set GITLAB_PROJECT (and GITLAB_TOKEN for private / self-hosted)
#
# SOURCE is optional; if unset: GITHUB_REPO → github, else GITLAB_PROJECT → gitlab, else demo.
# SOURCE=github
# SOURCE=gitlab
# SOURCE=demo

# Review ANY repository — set one of these (no code changes):
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=ghp_...   # read: ingest; write scopes needed to push branches / open PRs
# Fine-grained PAT on ma3u/healthgraph-agent: Contents (Read+Write), Pull requests (Read+Write)
# Classic PAT: repo scope
# GITLAB_PROJECT=group/project
# GITLAB_TOKEN=glpat-...

# Push ingested graph to Neo4j on startup (so Aura Agent sees live data). Default: on when Neo4j is set.
AUTO_SYNC_NEO4J=true
# SOURCE_FALLBACK=false

# Vite dev proxy targets the API (default http://127.0.0.1:4000). Client uses same-origin /api in dev.
# VITE_API_URL=http://127.0.0.1:4000
# CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# Neo4j (optional — leave unset for in-memory demo mode)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j

PORT=4000
# API binds to loopback by default (credentials never sent to the browser)
HOST=127.0.0.1
# Comma-separated Vite dev origins allowed to call the API
# CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Dangerous: allow POST /api/cypher (arbitrary Neo4j). Dev only.
# ENABLE_DEV_CYPHER=true

# -----------------------------------------------------------------------------
# GitHub
# -----------------------------------------------------------------------------
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=ghp_xxxxxxxx
# GITHUB_PR=512
# GITHUB_MAX_PRS=15
# GITHUB_API=https://api.github.com

# -----------------------------------------------------------------------------
# GitLab (GitLab.com or self-managed — organizations)
# -----------------------------------------------------------------------------
# GITLAB_PROJECT=group/subgroup/project
# GITLAB_TOKEN=glpat-xxxxxxxx
# GITLAB_MR=42
# GITLAB_MAX_MRS=15
# Self-hosted example:
# GITLAB_API=https://gitlab.yourcompany.com/api/v4

# -----------------------------------------------------------------------------
# Aura Agent (hosted GenAI Text2Cypher + LLM in "Ask the Graph")
# Create API keys: Aura Console → Account → API Keys
# Invoke URL: Agents tab → your agent → External access → copy …/invoke
# -----------------------------------------------------------------------------
# AURA_CLIENT_ID=your-client-id
# AURA_CLIENT_SECRET=your-client-secret
# AURA_AGENT_INVOKE_URL=https://api.neo4j.io/v2beta1/organizations/.../agents/.../invoke
# AURA_AGENT_MODE=primary
# AURA_AGENT_MODE=local
# AURA_AGENT_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Optional: architecture rules live in the repo as .reviewgraph.json
# (see docs/reviewgraph-config.example.json)
# -----------------------------------------------------------------------------
